# Build etrace as an SDE tool, so it can run during pinball replay:
#   make -f makefile.sde OBJDIR=obj-sde/ obj-sde/etrace.so
# Mirrors pinball2elf/pintools/PinballSYSState/makefile.rules.
SDE_BUILD_KIT ?= /home/dmk/fedora/sde/sde-external-10.13.1-2026-07-28-lin
PIN_ROOT      := $(SDE_BUILD_KIT)/pinkit
SDE_ROOT      := $(PIN_ROOT)/sde-example
PINPLAY_ROOT  := $(PIN_ROOT)/pinplay
CONFIG_ROOT   := $(PIN_ROOT)/source/tools/Config
include $(CONFIG_ROOT)/makefile.config
TOOL_CXXFLAGS += -Wno-maybe-uninitialized -DSDE_INIT -DPINPLAY \
                 -I$(SDE_ROOT)/include -I$(PINPLAY_ROOT)/include
# as in sde-example/example/makefile.rules
TOOL_CXXFLAGS += -DPIN_RT -D_LIBCPP_HAS_MUSL_LIBC -DPIN_DISABLE_CRT_REG_DEF
TOOL_CXXFLAGS += -Wno-sign-compare
TOOL_LPATHS   += -L$(SDE_ROOT)/lib/$(TARGET) -L$(PINPLAY_ROOT)/$(TARGET)
TOOL_LPATHS   += -lpinplay -lsde -lpinplay -lsde -lbz2 -lzlib
TOOL_ROOTS    := etrace
include $(CONFIG_ROOT)/makefile.default.rules
